#!/bin/sh /etc/rc.common
# openvpn-monitor - ubus monitoring of OpenVPN servers
#
# The daemon is started only when at least one enabled OpenVPN server
# with a management interface is configured AND its openvpn process is
# running. Otherwise start does nothing. The service is (re)evaluated:
#   - at boot (START=99, after openvpn),
#   - when /etc/config/openvpn changes (reload trigger),
#   - when an OpenVPN tunnel goes up/down (/etc/hotplug.d/openvpn/).

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/openvpn-monitor

FOUND=0

# Checks one UCI openvpn section:
# enabled server + management configured + openvpn process running
check_instance() {
	local sec="$1" type enable enabled management extra

	config_get type "$sec" type
	config_get enable "$sec" enable
	config_get enabled "$sec" enabled
	config_get management "$sec" management
	config_get extra "$sec" extra

	[ "$type" = "server" ] || return 0
	[ "${enable:-$enabled}" = "1" ] || return 0

	# management either as its own option or inside "extra" (RutOS WebUI)
	if [ -z "$management" ]; then
		case "$extra" in
			*management*) ;;
			*) return 0 ;;
		esac
	fi

	# the openvpn process for this instance must be running
	pgrep -f "openvpn-$sec.conf" >/dev/null || return 0

	FOUND=1
}

start_service() {
	FOUND=0
	config_load openvpn
	config_foreach check_instance openvpn

	if [ "$FOUND" != "1" ]; then
		logger -t openvpn-monitor "no running OpenVPN server with management interface, not starting"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/bin/lua "$PROG"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# restart instead of reload: ubus objects are registered at start
reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "openvpn"
}
